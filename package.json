{
  "name": "sri-ec-nestjs",
  "version": "0.4.0",
  "description": "Módulo NestJS de integración con sri-ec para facturación electrónica del SRI Ecuador.",
  "keywords": [
    "nestjs",
    "nest",
    "sri",
    "ecuador",
    "facturacion-electronica",
    "xades",
    "comprobantes-electronicos",
    "factura",
    "e-invoicing",
    "sri-ecuador",
    "firma-electronica",
    "p12"
  ],
  "homepage": "https://github.com/JonathanTeran/teran-sri-ec-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanTeran/teran-sri-ec-node.git",
    "directory": "packages/nestjs-sri-ec"
  },
  "bugs": {
    "url": "https://github.com/JonathanTeran/teran-sri-ec-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "author": "Jonathan Terán",
  "peerDependencies": {
    "sri-ec": "^0.4.0",
    "@nestjs/common": "^10 || ^11"
  }
}
